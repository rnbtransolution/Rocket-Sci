# ============================================================
# Bang Fai Commander — Environment Configuration Template
# IMPORTANT: Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ============================================================

# LINE Messaging API Credentials
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# Google Cloud Service Account Credentials (Path to JSON file)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Server Port
PORT=8080

# ============================================================================
# ⚠️  NEVER put a password, API key, or secret behind a VITE_ prefix. ⚠️
# ============================================================================
# Vite inlines every VITE_* variable into the JavaScript bundle at BUILD time.
# Anything prefixed VITE_ is therefore published in the page source to every
# anonymous visitor. An earlier version of this project shipped the admin API
# key and both admin passwords this way, which handed full admin access
# (including Factory Reset) to anyone who opened the page source.
#
# Usernames are safe to expose and may keep the VITE_ prefix for UI hints.
# Everything else lives ONLY as a Wrangler secret or a GAS Script Property.

# ── Worker secrets (wrangler secret put <NAME>) ──
# SESSION_SECRET          — HMAC key that signs admin session tokens. Must be
#                           rotated independently of the API keys.
# ADMIN_API_KEY           — server-to-server admin secret (GAS mirror, scripts).
#                           Never returned to the browser.
# ADMIN1_API_KEY          — limited-admin server-to-server secret.
# ADMIN_PASSWORD          — BOOTSTRAP ONLY. On first login this value is hashed
#                           into the Durable Object and the account is flagged
#                           "must change", after which this secret is unused.
# ADMIN_PASSWORD_1        — same, for the limited admin.
#
# Once an admin has completed their first password change, the live password
# lives ONLY as a PBKDF2 hash in the Durable Object and is rotated from the
# Admin Console. ADMIN_PASSWORD can then be deleted from the deployment.
#
# Password policy: >= 12 chars, 3 of 4 character classes, 30-day forced expiry
# enforced at login. Forgotten passwords are recovered with single-use
# Recovery Codes generated whenever a password is set.

# Generate secrets with: openssl rand -base64 48

# Admin credentials — Super Admin (Full access + Factory Reset)
ADMIN_USERNAME=replace_with_super_admin_username
ADMIN_PASSWORD=replace_with_bootstrap_password_min_12_chars
VITE_SUPER_ADMIN_USERNAME=replace_with_super_admin_username

# Admin credentials — Limited Admin (no Factory Reset)
ADMIN1_USERNAME=replace_with_admin1_username
ADMIN1_PASSWORD=replace_with_bootstrap_password_min_12_chars
VITE_LIMITED_ADMIN_USERNAME=replace_with_admin1_username

# Google Apps Script Web App URL (optional — used for GAS fallback RPC)
GAS_FALLBACK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Vite API Base URL (leave empty to auto-resolve via CF Worker fallback)
VITE_API_BASE_URL=
