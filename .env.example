# ============================================================
# Bang Fai Commander — Environment Configuration Template
# IMPORTANT: Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ============================================================

# LINE Messaging API Credentials
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# Google Cloud Service Account Credentials (Path to JSON file)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Server Port
PORT=8080

# Admin API Secret Key — generate a strong random string (min 32 chars)
# Example: openssl rand -base64 32
ADMIN_SECRET_KEY=replace_with_strong_random_secret_min_32_chars
ADMIN_API_KEY=replace_with_strong_random_secret_min_32_chars
VITE_ADMIN_API_KEY=replace_with_strong_random_secret_min_32_chars

# Super Admin credentials (Full access: all operations + factory reset)
# Use a strong unique password — never reuse across systems
VITE_SUPER_ADMIN_USERNAME=replace_with_super_admin_username
VITE_SUPER_ADMIN_PASSWORD=replace_with_strong_super_admin_password
VITE_ADMIN_USERNAME=replace_with_super_admin_username
VITE_ADMIN_PASSWORD=replace_with_strong_super_admin_password
VITE_ADMIN_PASSCODE=replace_with_strong_super_admin_password
ADMIN_USERNAME=replace_with_super_admin_username
ADMIN_PASSWORD=replace_with_strong_super_admin_password

# Admin1 credentials (Limited: field operations only, no factory reset)
VITE_LIMITED_ADMIN_USERNAME=replace_with_admin1_username
VITE_LIMITED_ADMIN_PASSWORD=replace_with_admin1_password
VITE_ADMIN1_USERNAME=replace_with_admin1_username
VITE_ADMIN1_PASSWORD=replace_with_admin1_password
ADMIN1_USERNAME=replace_with_admin1_username
ADMIN1_PASSWORD=replace_with_admin1_password
ADMIN1_API_KEY=replace_with_strong_random_admin1_key

# Google Apps Script Web App URL (optional — used for GAS fallback RPC)
GAS_FALLBACK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Vite API Base URL (leave empty to auto-resolve via CF Worker fallback)
VITE_API_BASE_URL=
